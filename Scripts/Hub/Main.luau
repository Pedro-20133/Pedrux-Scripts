-- 👇 YOUR MAIN SCRIPT CODE STARTS HERE 👇
-------------------------------------------------------------------------------

local Rayfield = loadstring(game:HttpGet("https://sirius.menu/gen2"))()
local window = Rayfield:CreateWindow({
	name = "Pedrux Hub - Hub",
	subtitle = "Rayfield Gen2",
	sidebarLayout = true,
})
local tabs = {}

local SCRIPT = _G.SCRIPT_NAME
if SCRIPT ~= "" then
	for _, scr in ipairs(scripts) do
		loadstring(game:HttpGet(scr.Link))()
		task.delay(0.5, function()
			window:Unload()
		end)
	end
end

tabs["Main"] = window:CreateTab({ Name = "Main", Icon = 4483362458 })
for _, scr in pairs(scripts) do
	tabs[scr.Name] = window:CreateTab({ Name = scr.Name, Icon = nil })

	if scr.Configs then
		for _, config in pairs(scr.Configs) do
			if config.tipo == "toggle" then
				tabs[scr.Name]:CreateToggle({
					Name = config.text,
					CurrentValue = config.value,
					Flag = config.text,
					Callback = function(Value)
						config.value = Value -- Atualiza o value automaticamente
						if config.callback then config.callback(Value) end
					end,
				})

			elseif config.tipo == "slider" then
				tabs[scr.Name]:CreateSlider({
					Name = config.text,
					Range = {config.min or 0, config.max or 100},
					Increment = config.step or 1,
					CurrentValue = config.value,
					Flag = config.text,
					Callback = function(Value)
						config.value = Value -- Atualiza o value automaticamente
						if config.callback then config.callback(Value) end
					end,
				})

			elseif config.tipo == "dropdown" then
				tabs[scr.Name]:CreateDropdown({
					Name = config.text,
					Options = config.options or {},
					CurrentOption = {config.value or config.options[1]},
					MultipleOptions = false,
					Flag = config.text,
					Callback = function(Value)
						local selected = type(Value) == "table" and Value[1] or Value
						config.value = selected -- Atualiza o value automaticamente
						if config.callback then config.callback(selected) end
					end,
				})

			elseif config.tipo == "input" then
				tabs[scr.Name]:CreateInput({
					Name = config.text,
					PlaceholderText = config.placeholder or "Digite aqui...",
					RemoveTextAfterFocusLost = false,
					Callback = function(Text)
						config.value = Text -- Atualiza o value automaticamente
						if config.callback then config.callback(Text) end
					end,
				})
			end
		end
	end

	tabs[scr.Name]:CreateButton({
		Name = "Executar Script",
		Info = "Roda o script remoto",
		Interact = "Run",
		Callback = function()
			loadstring(game:HttpGet(scr.Link))()
			task.delay(0.5, function()
				window:Unload()
			end)
		end,
	})
end

tabs["Main"]:CreateButton({
	name = "Exit",
	callback = function()
		window:Unload()
	end,
})
